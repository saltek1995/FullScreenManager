<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\FullScreenManager.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FullScreenManager</AssemblyName>
    <RootNamespace>FullScreenManager</RootNamespace>
    <Product>FullScreenManager</Product>
    <Description>macOS-style fullscreen virtual desktops for Windows</Description>
    <Company>FullScreenManager</Company>
    <Version>1.0.42</Version>
  </PropertyGroup>
</Project>
